# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase Dashboard -> Project Settings -> API.
#
# If both values are left empty the app runs in local demo mode (no auth,
# in-memory data). Run `npm run sandbox` for demo mode with fake roommates.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
