# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase Dashboard -> Project Settings -> API.
#
# If both Supabase values are left empty the app runs in local demo mode (no
# auth, in-memory data) and says so in a banner. Run `npm run sandbox` for demo
# mode with fake roommates.
#
# A *production* build refuses to start without them, so a typo can't ship an
# app that silently discards everything people enter. Set NEXT_PUBLIC_SANDBOX
# if you genuinely want to deploy a demo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the deployment, used for Open Graph and manifest URLs.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Optional: error tracking
# ---------------------------------------------------------------------------
# Without a DSN, errors are only logged to the console. With one, they are also
# reported to Sentry (user ids only, never emails or payment handles).
NEXT_PUBLIC_SENTRY_DSN=

# Set all three to upload source maps at build time, so stack traces name real
# functions. Build works fine without them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Optional: daily reminder emails (see /api/reminders and vercel.json)
# ---------------------------------------------------------------------------
# All four are needed together; with any of them missing the endpoint does
# nothing and says which. The service-role key is server-only and must never
# be exposed to the browser — it bypasses row-level security by design.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
REMINDER_FROM="DivvyUp <reminders@yourdomain.com>"
# Any long random string. Vercel Cron sends it as a bearer token; requests
# without it are refused.
CRON_SECRET=
